# Токен от @BotFather
BOT_TOKEN=123456:AA...

# Путь к базе (SQLite)
DB_PATH=data/freelance.db

# Как часто опрашивать источники, секунд
POLL_INTERVAL=600

# Минимальный балл релевантности, с которого заказ считается "моим"
MIN_SCORE=5

# Сколько заказов максимум слать одному чату за один цикл опроса
MAX_PER_CYCLE=10

# Таймаут HTTP-запроса, секунд
REQUEST_TIMEOUT=20

# Telegram id админов через запятую (не обязательно)
ADMIN_IDS=
