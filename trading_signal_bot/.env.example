# Токен от @BotFather
BOT_TOKEN=123456:AA...

# Путь к базе (SQLite)
DB_PATH=data/trading.db

# Порт, на котором бот принимает вебхуки от TradingView (POST /webhook/<WEBHOOK_SECRET>)
PORT=8080

# Секрет в пути вебхука — придумай длинную случайную строку.
# Настрой в каждом алерте TradingView URL: http://<твой-vps>:8080/webhook/<этот секрет>
WEBHOOK_SECRET=

# Кому слать сигналы без нажатия /start (id чатов через запятую, не обязательно)
TARGET_CHAT_IDS=
# Telegram id админов через запятую (не обязательно, пока не используется отдельно)
ADMIN_IDS=

# --- Агрегация сигналов от индикаторов ---
# Сколько всего индикаторов подключено в TradingView
TOTAL_INDICATORS=7
# Сколько из них должны согласованно подтвердить сигнал, чтобы бот его обработал
MIN_CONFIRMATIONS=4
# Окно, в котором собираются подтверждения по одному символу/таймфрейму/направлению, сек
SIGNAL_WINDOW_SECONDS=900
# Не слать повторно тот же сетап чаще, чем раз в столько секунд
DISPATCH_COOLDOWN_SECONDS=1800

# --- Проверка через ИИ (Claude API) ---
AI_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Не отправлять ордер, если ИИ его не одобрил
AI_BLOCK_ON_REJECT=true
# Присылать уведомление, что сетап отклонён ИИ (иначе тихо пропускается)
AI_NOTIFY_REJECTED=true

# --- Параметры аккаунта проп-компании и риска ---
ACCOUNT_BALANCE=100000
ACCOUNT_CURRENCY=USD
# Риск на одну сделку, % от баланса
RISK_PER_TRADE_PCT=0.5
# Дневной лимit убытка твоей проп-компании, % от баланса
MAX_DAILY_LOSS_PCT=4
# Общий лимит просадки проп-компании, % (пока используется только в /status как справка)
MAX_TOTAL_DRAWDOWN_PCT=8
# Максимум сделок в день
MAX_DAILY_TRADES=5
# Запасное соотношение риск/прибыль, если индикатор не прислал тейк
DEFAULT_RISK_REWARD=2.0
# Запасной стоп в % от цены, если ни один индикатор не прислал стоп
DEFAULT_SL_PCT=0.5
# Шаг и минимальный объём лота у брокера
LOT_STEP=0.01
MIN_LOT=0.01
# Путь к JSON с параметрами инструментов, которых нет в trading_signal_bot/instruments.py
INSTRUMENTS_FILE=
